---
import { fetchOgp } from '../lib/ogp';

interface Props {
	/** カード化したいリンク先 URL */
	url: string;
}

const { url } = Astro.props;
const o = await fetchOgp(url);
const hasImage = Boolean(o.image);
---

<a
	class:list={['link-card', { 'link-card--with-image': hasImage }]}
	href={o.url}
	target="_blank"
	rel="noopener noreferrer"
>
	<div class="link-card__body">
		<div class="link-card__title">{o.title}</div>
		{o.description && <p class="link-card__desc">{o.description}</p>}
		<div class="link-card__site">
			{o.favicon && (
				<img
					class="link-card__favicon"
					src={o.favicon}
					alt=""
					width="16"
					height="16"
					loading="lazy"
					decoding="async"
				/>
			)}
			<span>{o.siteName}</span>
		</div>
	</div>
	{
		hasImage && (
			<div class="link-card__thumb">
				<img src={o.image} alt="" loading="lazy" decoding="async" />
			</div>
		)
	}
</a>

<style>
	.link-card {
		display: flex;
		align-items: stretch;
		justify-content: space-between;
		gap: 0;
		margin: 1.25em 0;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 12px;
		overflow: hidden;
		background: #fff;
		text-decoration: none;
		color: rgb(var(--gray-dark));
		transition: border-color 0.2s ease;
	}
	.link-card:hover {
		border-color: rgb(var(--gray));
	}

	.link-card__body {
		display: flex;
		flex-direction: column;
		gap: 0.4em;
		padding: 0.9em 1em;
		min-width: 0;
		flex: 1 1 auto;
	}

	.link-card__title {
		font-weight: 700;
		line-height: 1.4;
		/* 2 行で省略 */
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.link-card__desc {
		margin: 0;
		font-size: 0.85em;
		line-height: 1.5;
		color: rgb(var(--gray));
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.link-card__site {
		display: flex;
		align-items: center;
		gap: 0.4em;
		margin-top: auto;
		font-size: 0.8em;
		color: rgb(var(--gray));
	}
	.link-card__favicon {
		width: 16px;
		height: 16px;
		border-radius: 3px;
		flex-shrink: 0;
	}
	.link-card__site span {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.link-card__thumb {
		flex: 0 0 auto;
		width: 180px;
	}
	.link-card__thumb img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	@media (max-width: 520px) {
		.link-card--with-image {
			flex-direction: column-reverse;
		}
		.link-card__thumb {
			width: 100%;
			aspect-ratio: 1.91 / 1;
		}
	}
</style>
