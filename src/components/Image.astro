---
import { Image as AstroImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	/** import した画像 (例: import img from '../../assets/foo.jpg') */
	src: ImageMetadata;
	/** 代替テキスト */
	alt: string;
	/** 必要なときだけ幅を上書き。未指定なら固定値を使う */
	width?: number;
}

/** 本文中の画像のデフォルト表示幅 (px) */
const DEFAULT_WIDTH = 720;

const { src, alt, width = DEFAULT_WIDTH } = Astro.props;
---

<AstroImage src={src} alt={alt} width={width} class="blog-image" />

<style>
	.blog-image {
		display: block;
		margin-inline: auto;
		max-width: 100%;
		height: auto;
		border-radius: 8px;
	}
</style>
